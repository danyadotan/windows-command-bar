{
  "name": "winpilot-command-bar",
  "version": "0.1.1",
  "private": true,
  "description": "A safety-first Windows command bar for AI and local tasks",
  "author": "Danya Dotan",
  "repository": "github:danyadotan/windows-command-bar",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && vite build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "concurrently -k \"tsc -p tsconfig.json --watch\" \"vite\" \"wait-on http://localhost:5173 dist/main/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "package:win": "npm run build:native-host && npm run build && electron-builder --win nsis --x64 --publish never",
    "build:native-host": "node scripts/build-native-host.cjs",
    "start": "electron .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.4"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "^5.1.0"
    }
  },
  "build": {
    "appId": "io.dynamicbridge.winpilot",
    "productName": "WinPilot",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native-host/bin/WinPilotNativeHost.exe",
        "to": "native-host/WinPilotNativeHost.exe"
      },
      {
        "from": "native-host/io.dynamicbridge.winpilot.json",
        "to": "native-host/io.dynamicbridge.winpilot.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WinPilot-Setup-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WinPilot"
    }
  }
}
